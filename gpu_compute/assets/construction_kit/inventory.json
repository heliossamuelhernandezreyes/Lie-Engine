        "actual front/back geometry",
        "native aperture/silhouette tests",
        "LOD coverage checks"
      ]
    },
    "painted_coatings": {
      "status": "conditional",
      "requirements": [
        "opaque dielectric source material",
        "no silent metallic override"
      ]
    },
    "metal_exposed": {
      "status": "requires_another_material_backend",
      "reason": "80-byte compiler rejects metallicFactor != 0"
    },
    "glass_water_alpha_foliage": {
      "status": "requires_another_capture_or_material_path",
      "reason": "alpha/transmission/refraction unsupported here; opaque mesh leaves remain separate candidates"
    },
    "normal_displacement_ao_emission": {
      "status": "requires_explicit_source_conversion_or_other_backend",
      "reason": "no tangent normal/displacement/AO/emission channels in this immutable capture ABI"
    },
    "skinned_or_deforming_assets": {
      "status": "requires_geometry_animation_integration",
      "reason": "static import alone does not implement generic deformation; rigid instance motion is separate"
    }
  },
