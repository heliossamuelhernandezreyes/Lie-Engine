// Fixed-capacity quality contract. No brick counts or source-ID arithmetic.
// q.x=1/6 angular sectors; q.y=area-weighted cutoff; q.z=dynamic boxes.
layout(set=0,binding=27,std430) readonly buffer FieldQuality {
    uvec4 q; vec4 parameters; vec4 data[];
} quality;
// Flat vec4 streams make the 32-byte packet layout explicit on every driver.
layout(set=0,binding=28,std430) buffer LobeA {vec4 v[];} lobe_a;
layout(set=0,binding=29,std430) buffer LobeB {vec4 v[];} lobe_b;
layout(set=0,binding=30,std430) buffer LobeCaps {vec4 v[];} lobe_caps;
layout(set=0,binding=31,std430) buffer EdgeState {uvec2 v[];} edge_state;
const uint LIE_SECTORS=6u;
uint lie_sector(uint node,vec3 direction) {
    if(quality.q.x==1u || optical.values[node].albedo_roughness.w>=quality.parameters.y)return 0u;
    // Tangent-frame sectors rotate with the authored optical normal.
    vec3 n=normalize(optical.values[node].normal_pad.xyz);
    vec3 axis=abs(n.z)<.9?vec3(0,0,1):vec3(0,1,0);
    vec3 t=normalize(cross(axis,n)),b=cross(n,t);
    vec3 d=vec3(dot(direction,t),dot(direction,b),dot(direction,n));
    vec3 a=abs(d);
    uint k=a.x>=a.y && a.x>=a.z?0u:a.y>=a.z?1u:2u;
    float sign_value=k==0u?d.x:k==1u?d.y:d.z;
    return min(k*2u+(sign_value>=0.?0u:1u),5u);
}
bool lie_dynamic_clear(vec3 a,vec3 b) {
    for(uint j=0u;j<quality.q.z;j++) {
        uint at=uint(cfg.dims.x)+j*2u;
        if(lie_segment_box(a,b,quality.data[at].xyz,quality.data[at+1u].xyz))return false;
    }
    return true;
}
float lie_quality_reach(uint node,float parent,vec3 outgoing) {
    if(cfg.tuning.w<.5)return 0.;
    float power=max(outgoing.r,max(outgoing.g,outgoing.b));
    float share=quality.q.y!=0u?quality.data[node].x:1.;
    float radius=cfg.tuning.w>1.5?
        min(parent*cfg.radii.y,sqrt(max(power,0.)/(3.141592653589793*cfg.radii.z*share))):
        min(parent*cfg.radii.y*sqrt(max(rho(node).r,max(rho(node).g,rho(node).b))),
            cfg.radii.x*sqrt(max(power,0.)/(cfg.radii.z*share)));
    return min(radius,cfg.radii.x)*radius_scale.values[node];
}
vec4 lie_read_flux(uint id,int ping) {return ping==0?lobe_a.v[id*2u]:lobe_b.v[id*2u];}
vec3 lie_read_travel(uint id,int ping) {return ping==0?lobe_a.v[id*2u+1u].xyz:lobe_b.v[id*2u+1u].xyz;}
void lie_write_lobe(uint id,int ping,vec4 flux,vec3 travel) {
    if(ping==0){lobe_a.v[id*2u]=flux;lobe_a.v[id*2u+1u]=vec4(travel,0);}
    else {lobe_b.v[id*2u]=flux;lobe_b.v[id*2u+1u]=vec4(travel,0);}
}
bool lie_quality_step(uint id) {
    uint n=uint(cfg.dims.x),L=uint(cfg.dims.y);int stage=phase.data.x,ping=phase.data.y;
    uint edge_count=uint(quality.parameters.z);
    if(stage==8) {
        if(id>=edge_count*2u)return true;
        vec2 ends=quality.data[n+32u+id].xy;uint source=uint(ends.x),receiver=uint(ends.y);
        vec3 a=patches.values[source].center_area.xyz,b=patches.values[receiver].center_area.xyz;
        vec3 delta=b-a;vec3 direction=dot(delta,delta)>1e-16?normalize(delta):vec3(0,0,1);
        edge_state.v[id]=uvec2(lie_sector(receiver,direction),lie_dynamic_clear(a,b)?1u:0u);
        return true;
    }
    if(stage==0 || stage==1 || stage==4)return false;
    uint logical=stage==3?id/LIE_SECTORS:id;
    if(logical>=n*L)return true;
    uint node=logical%n,light=logical/n;
    if(stage==2) {
        vec3 incoming=lights.values[light].power.rgb*(weights.values[id]/caps.values[light])*
            transmittance(patches.values[node].center_area.xyz,lights.values[light].position_radius.xyz);
        vec3 delta=patches.values[node].center_area.xyz-lights.values[light].position_radius.xyz;
        vec3 travel=dot(delta,delta)>1e-16?normalize(delta):-patches.values[node].normal_gray.xyz;
        vec3 D,R;parts(node,travel,D,R);
        float parent=max(incoming.r,max(incoming.g,incoming.b))>0.?lights.values[light].position_radius.w:0.;
        float radius=lie_quality_reach(node,parent,incoming*(D+R));
        uint bin=lie_sector(node,travel);
        for(uint s=0u;s<LIE_SECTORS;s++) {
            lie_write_lobe(id*LIE_SECTORS+s,0,s==bin?vec4(incoming,radius):vec4(0),travel);
            lie_write_lobe(id*LIE_SECTORS+s,1,vec4(0),travel);
        }
        // Preserve public aggregate frontier and direct/indirect bridge ABI.
        frontier_a.values[id]=vec4(incoming,radius);frontier_b.values[id]=vec4(0);
        channel_received.values[id]=vec4(incoming,0);return true;
    }
    if(stage==5) {
        uint ob=outgoing_graph.values[2],eb=outgoing_graph.values[3];
        for(uint s=0u;s<LIE_SECTORS;s++) {
            uint packet=id*LIE_SECTORS+s;vec4 emitted=lie_read_flux(packet,ping);vec2 sum=vec2(0);
            if(max(emitted.r,max(emitted.g,emitted.b))>0.)
            for(uint e=outgoing_graph.values[ob+node];e<outgoing_graph.values[ob+node+1u];e++) {
                uint dst=outgoing_graph.values[eb+e*2u];
                if(edge_state.v[edge_count+e].y==0u)continue;
                float F=uintBitsToFloat(outgoing_graph.values[eb+e*2u+1u]);
                sum+=angular_weight(node,dst,F,lie_read_travel(packet,ping),emitted.w);
            }
            lobe_caps.v[packet]=vec4(max(sum,vec2(1)),0,0);
        }
        return true;
    }
    if(stage==3) {
        // One receiver/sector per invocation: no dynamically indexed local
        // scatter arrays. All global writes have an explicit packet bound.
        uint target=id%LIE_SECTORS;
        uint source_sector=uint(phase.data.z);
        vec4 previous=lie_read_flux(id,1-ping);
        vec3 flux=source_sector==0u?vec3(0):previous.rgb;
        vec3 moment=source_sector==0u?vec3(0):lie_read_travel(id,1-ping);
        float parent=source_sector==0u?0.:previous.w;
        if(target!=0u && (quality.q.x==1u || optical.values[node].albedo_roughness.w>=quality.parameters.y)) {
            if(source_sector==0u)lie_write_lobe(id,1-ping,vec4(0),vec3(0));
            return true;
        }
        uint ob=factors.values[2],eb=factors.values[3];
        for(uint e=factors.values[ob+node];e<factors.values[ob+node+1u];e++) {
            uint src=factors.values[eb+e*2u];
            vec3 delta=patches.values[node].center_area.xyz-patches.values[src].center_area.xyz;
            if(edge_state.v[e].y==0u)continue;
            vec3 direction=normalize(delta);uint bin=edge_state.v[e].x;
            if(bin!=target)continue;
            float F=uintBitsToFloat(factors.values[eb+e*2u+1u]);
                uint packet=(light*n+src)*LIE_SECTORS+source_sector;vec4 emitted=lie_read_flux(packet,ping);
                if(max(emitted.r,max(emitted.g,emitted.b))<=0.)continue;
                vec3 travel=lie_read_travel(packet,ping),D,R;parts(src,travel,D,R);
                vec2 w=angular_weight(src,node,F,travel,emitted.w)/lobe_caps.v[packet].xy;
                vec3 value=emitted.rgb*(D*w.x+R*w.y)*
                    transmittance(patches.values[src].center_area.xyz,patches.values[node].center_area.xyz);
                flux+=value;float strength=max(value.r,max(value.g,value.b));
                moment+=direction*strength;if(strength>0.)parent=max(parent,emitted.w);
        }
        // Keep the unnormalized moment until every source sector contributed.
        lie_write_lobe(id,1-ping,vec4(flux,parent),moment);return true;
    }
    if(stage==7) {
        vec3 total=vec3(0),outgoing=vec3(0);float parent=0.;
        for(uint s=0u;s<LIE_SECTORS;s++) {
            vec4 emitted=lie_read_flux(id*LIE_SECTORS+s,1-ping);vec3 travel=lie_read_travel(id*LIE_SECTORS+s,1-ping);
            travel=dot(travel,travel)>1e-16?normalize(travel):-patches.values[node].normal_gray.xyz;
            vec3 D,R;parts(node,travel,D,R);outgoing+=emitted.rgb*(D+R);
            total+=emitted.rgb;parent=max(parent,emitted.w);
        }
        // Share the node's aggregate reach across bins: angular subdivision
        // must not introduce a second per-bin energy cutoff.
        float radius=lie_quality_reach(node,parent,outgoing);
        for(uint s=0u;s<LIE_SECTORS;s++) {
            vec4 emitted=lie_read_flux(id*LIE_SECTORS+s,1-ping);vec3 travel=lie_read_travel(id*LIE_SECTORS+s,1-ping);
            travel=dot(travel,travel)>1e-16?normalize(travel):-patches.values[node].normal_gray.xyz;
            lie_write_lobe(id*LIE_SECTORS+s,1-ping,vec4(emitted.rgb,radius),travel);
        }
        if(ping==0)frontier_b.values[id]=vec4(total,radius);else frontier_a.values[id]=vec4(total,radius);
        channel_received.values[id].rgb+=total;return true;
    }
    return true;
}
