// Fixed-capacity quality contract. No brick counts or source-ID arithmetic.
// q.x=1/6 angular sectors; q.y=area-weighted cutoff; q.z=dynamic boxes.
layout(set=0,binding=27,std430) readonly buffer FieldQuality {
    uvec4 q; vec4 parameters; vec4 data[];
} quality;
struct LieLobe {vec4 flux_radius;vec4 travel;};
layout(set=0,binding=28,std430) buffer LobeA {LieLobe v[];} lobe_a;
layout(set=0,binding=29,std430) buffer LobeB {LieLobe v[];} lobe_b;
layout(set=0,binding=30,std430) buffer LobeCaps {vec4 v[];} lobe_caps;
const uint LIE_SECTORS=6u;
uint lie_sector(uint node,vec3 direction) {
    if(quality.q.x==1u || optical.values[node].albedo_roughness.w>=quality.parameters.y)return 0u;
    // Tangent-frame sectors rotate with the authored optical normal.
    vec3 n=normalize(optical.values[node].normal_pad.xyz);
    vec3 axis=abs(n.z)<.9?vec3(0,0,1):vec3(0,1,0);
    vec3 t=normalize(cross(axis,n)),b=cross(n,t);
    vec3 d=vec3(dot(direction,t),dot(direction,b),dot(direction,n));
    vec3 a=abs(d);
    uint k=a.x>=a.y && a.x>=a.z?0u:a.y>=a.z?1u:2u;
    return k*2u+(d[int(k)]>=0.?0u:1u);
}
bool lie_dynamic_clear(vec3 a,vec3 b) {
    for(uint j=0u;j<quality.q.z;j++) {
        uint at=uint(cfg.dims.x)+j*2u;
        if(lie_segment_box(a,b,quality.data[at].xyz,quality.data[at+1u].xyz))return false;
    }
    return true;
}
float lie_quality_reach(uint node,float parent,vec3 outgoing) {
    if(cfg.tuning.w<.5)return 0.;
    float power=max(outgoing.r,max(outgoing.g,outgoing.b));
    float share=quality.q.y!=0u?quality.data[node].x:1.;
    float radius=cfg.tuning.w>1.5?
        min(parent*cfg.radii.y,sqrt(max(power,0.)/(3.141592653589793*cfg.radii.z*share))):
        min(parent*cfg.radii.y*sqrt(max(rho(node).r,max(rho(node).g,rho(node).b))),
            cfg.radii.x*sqrt(max(power,0.)/(cfg.radii.z*share)));
    return min(radius,cfg.radii.x)*radius_scale.values[node];
}
LieLobe lie_read_lobe(uint id,int ping) {return ping==0?lobe_a.v[id]:lobe_b.v[id];}
void lie_write_lobe(uint id,int ping,LieLobe packet) {
    if(ping==0)lobe_a.v[id]=packet;else lobe_b.v[id]=packet;
}
bool lie_quality_step(uint id) {
    uint n=uint(cfg.dims.x),L=uint(cfg.dims.y);int stage=phase.data.x,ping=phase.data.y;
    if(stage==0 || stage==1 || stage==4)return false;
    if(id>=n*L)return true;
    uint node=id%n,light=id/n;
    if(stage==2) {
        vec3 incoming=lights.values[light].power.rgb*(weights.values[id]/caps.values[light])*
            transmittance(patches.values[node].center_area.xyz,lights.values[light].position_radius.xyz);
        vec3 delta=patches.values[node].center_area.xyz-lights.values[light].position_radius.xyz;
        vec3 travel=dot(delta,delta)>1e-16?normalize(delta):-patches.values[node].normal_gray.xyz;
        vec3 D,R;parts(node,travel,D,R);
        float parent=max(incoming.r,max(incoming.g,incoming.b))>0.?lights.values[light].position_radius.w:0.;
        float radius=lie_quality_reach(node,parent,incoming*(D+R));
        uint bin=lie_sector(node,travel);
        for(uint s=0u;s<LIE_SECTORS;s++) {
            LieLobe packet;packet.flux_radius=s==bin?vec4(incoming,radius):vec4(0);
            packet.travel=vec4(travel,0);lobe_a.v[id*LIE_SECTORS+s]=packet;
            packet.flux_radius=vec4(0);lobe_b.v[id*LIE_SECTORS+s]=packet;
        }
        // Preserve public aggregate frontier and direct/indirect bridge ABI.
        frontier_a.values[id]=vec4(incoming,radius);frontier_b.values[id]=vec4(0);
        channel_received.values[id]=vec4(incoming,0);return true;
    }
    if(stage==5) {
        uint ob=outgoing_graph.values[2],eb=outgoing_graph.values[3];
        for(uint s=0u;s<LIE_SECTORS;s++) {
            uint packet=id*LIE_SECTORS+s;LieLobe p=lie_read_lobe(packet,ping);vec2 sum=vec2(0);
            if(max(p.flux_radius.r,max(p.flux_radius.g,p.flux_radius.b))>0.)
            for(uint e=outgoing_graph.values[ob+node];e<outgoing_graph.values[ob+node+1u];e++) {
                uint dst=outgoing_graph.values[eb+e*2u];
                if(!lie_dynamic_clear(patches.values[node].center_area.xyz,patches.values[dst].center_area.xyz))continue;
                float F=uintBitsToFloat(outgoing_graph.values[eb+e*2u+1u]);
                sum+=angular_weight(node,dst,F,p.travel.xyz,p.flux_radius.w);
            }
            lobe_caps.v[packet]=vec4(max(sum,vec2(1)),0,0);
        }
        return true;
    }
    if(stage==3) {
        vec3 flux[6],moment[6];float parent=0.;
        for(uint s=0u;s<LIE_SECTORS;s++){flux[s]=vec3(0);moment[s]=vec3(0);}
        uint ob=factors.values[2],eb=factors.values[3];
        for(uint e=factors.values[ob+node];e<factors.values[ob+node+1u];e++) {
            uint src=factors.values[eb+e*2u];
            vec3 delta=patches.values[node].center_area.xyz-patches.values[src].center_area.xyz;
            if(!lie_dynamic_clear(patches.values[src].center_area.xyz,patches.values[node].center_area.xyz))continue;
            vec3 direction=normalize(delta);uint bin=lie_sector(node,direction);
            float F=uintBitsToFloat(factors.values[eb+e*2u+1u]);
            for(uint s=0u;s<LIE_SECTORS;s++) {
                uint packet=(light*n+src)*LIE_SECTORS+s;LieLobe p=lie_read_lobe(packet,ping);
                if(max(p.flux_radius.r,max(p.flux_radius.g,p.flux_radius.b))<=0.)continue;
                vec3 D,R;parts(src,p.travel.xyz,D,R);
                vec2 w=angular_weight(src,node,F,p.travel.xyz,p.flux_radius.w)/lobe_caps.v[packet].xy;
                vec3 value=p.flux_radius.rgb*(D*w.x+R*w.y)*
                    transmittance(patches.values[src].center_area.xyz,patches.values[node].center_area.xyz);
                flux[bin]+=value;float strength=max(value.r,max(value.g,value.b));
                moment[bin]+=direction*strength;if(strength>0.)parent=max(parent,p.flux_radius.w);
            }
        }
        vec3 total=vec3(0),outgoing=vec3(0);vec3 directions[6];
        for(uint s=0u;s<LIE_SECTORS;s++) {
            directions[s]=dot(moment[s],moment[s])>1e-16?normalize(moment[s]):-patches.values[node].normal_gray.xyz;
            vec3 D,R;parts(node,directions[s],D,R);outgoing+=flux[s]*(D+R);total+=flux[s];
        }
        // Share the node's aggregate reach across bins: angular subdivision
        // must not introduce a second per-bin energy cutoff.
        float radius=lie_quality_reach(node,parent,outgoing);
        for(uint s=0u;s<LIE_SECTORS;s++) {
            LieLobe p;p.flux_radius=vec4(flux[s],radius);p.travel=vec4(directions[s],0);
            lie_write_lobe(id*LIE_SECTORS+s,1-ping,p);
        }
        if(ping==0)frontier_b.values[id]=vec4(total,radius);else frontier_a.values[id]=vec4(total,radius);
        channel_received.values[id].rgb+=total;return true;
    }
    return true;
}
