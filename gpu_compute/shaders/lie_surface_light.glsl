#[compute]
#version 450
// Generated by tools/lie_light_field_shader.py.
// Common opaque field: independent directional frontiers per source light.
// All powers and colors are LINEAR RGB. No screen pixels or visible source mesh.
layout(local_size_x=64,local_size_y=1,local_size_z=1) in;
struct Patch { vec4 center_area; vec4 normal_gray; vec4 filter_absorption; };
struct Light { vec4 position_radius; vec4 power; };
struct Blocker { vec4 lo; vec4 hi; };
struct Triangle { vec4 a; vec4 b; vec4 c; };
struct Sheet { vec4 center_thickness; vec4 right_width; vec4 up_height; vec4 sigma_ior; };
layout(set=0,binding=13,std430) readonly buffer Sheets { Sheet values[]; } sheets;
layout(set=0,binding=0,std430) readonly buffer Patches { Patch values[]; } patches;
layout(set=0,binding=1,std430) readonly buffer Lights { Light values[]; } lights;
layout(set=0,binding=2,std430) readonly buffer Factors { uint values[]; } factors;
layout(set=0,binding=3,std430) buffer Weights { float values[]; } weights;
layout(set=0,binding=4,std430) buffer Caps { float values[]; } caps;
layout(set=0,binding=5,std430) buffer FrontierA { vec4 values[]; } frontier_a;
layout(set=0,binding=6,std430) buffer FrontierB { vec4 values[]; } frontier_b;
layout(set=0,binding=7,std430) buffer Received { vec4 values[]; } received;
layout(set=0,binding=8,std430) readonly buffer Config { ivec4 dims; vec4 tuning; vec4 radii; } cfg;
layout(set=0,binding=12,std430) readonly buffer RadiusScale { float values[]; } radius_scale;
layout(set=0,binding=9,std430) readonly buffer Blockers { Blocker values[]; } blockers;
layout(set=0,binding=11,std430) readonly buffer Triangles { Triangle values[]; } triangles;
/* LIE-WALL02 optional visibility accelerator, NOT collision geometry.
   uvec4: [brick_count, node_count_per_brick, mortar_node_id, reserved].
   BBox pairs are derived from original scanned brick dimension, not meshes.
   The base LIE11 inverse-square/energy/bounce equations remain unchanged. */
layout(set=0,binding=17,std430) readonly buffer BrickVisibility {
    uvec4 configuration;
    vec4 bounds[];
} brick_visibility;
layout(rgba32f,set=0,binding=10) uniform writeonly image2D irradiance;
layout(push_constant,std430) uniform Phase { ivec4 data; } phase;

const float PI=3.141592653589793;
struct Optical { vec4 albedo_roughness; vec4 properties; vec4 sigma; vec4 normal_pad; };
layout(set=0,binding=18,std430) buffer IncidentDirections { vec4 values[]; } incidents;
layout(set=0,binding=19,std430) readonly buffer OpticalCodes { uvec4 config; Optical values[]; } optical;
layout(set=0,binding=20,std430) buffer AngularCaps { vec4 values[]; } angular_caps;
layout(set=0,binding=21,std430) readonly buffer OutgoingGraph { uint values[]; } outgoing_graph;
layout(set=0,binding=22,std430) readonly buffer SourceFrontCaps { vec4 values[]; } front_caps;
vec3 incident(uint source,int ping) {return incidents.values[source*2u+uint(ping)].xyz;}
// Opaque finite-patch response. Positions in meters; relative linear RGB power.
// A passive approximation, not a calibrated GGX BSDF or a transmission solver.
void lie_passive_parts(vec3 albedo, float metal, float ior, float absorption,
                       vec3 normal, vec3 travel, out vec3 D, out vec3 R) {
    float ci=clamp(-dot(normal,travel),0.,1.);
    if(ci<=1e-8) {D=vec3(0);R=vec3(0);return;}
    float f_dielectric=pow((ior-1.)/(ior+1.),2.);
    vec3 f0=mix(vec3(f_dielectric),albedo,metal);
    vec3 f=f0+(vec3(1)-f0)*pow(1.-ci,5.);
    D=(1.-metal)*(vec3(1)-f)*albedo*(1.-absorption);
    R=f*(1.-absorption);
    vec3 cap=max(vec3(1),D+R);D/=cap;R/=cap;
}
vec2 lie_passive_weights(vec3 delta, vec3 geometric_normal, vec3 shading_normal,
                         float roughness, vec3 travel, float F,
                         bool bounded, float radius) {
    float d=length(delta);if(d<=1e-8)return vec2(0);
    vec3 out_dir=delta/d;
    float baseline=max(dot(geometric_normal,out_dir),1e-6);
    float diffuse=max(dot(shading_normal,out_dir),0.);
    float rough=max(roughness,.025);
    float expo=clamp(2./(rough*rough)-2.,1.,2048.);
    float gloss=diffuse>0.?pow(max(dot(reflect(travel,shading_normal),out_dir),0.),expo):0.;
    float fade=bounded?(radius>0.?pow(max(0.,1.-pow(d/radius,4.)),2.):0.):1.;
    return F*fade*vec2(diffuse,gloss)/baseline;
}

void parts(uint source,vec3 direction,out vec3 D,out vec3 R) {
    Optical o=optical.values[source];
    lie_passive_parts(o.albedo_roughness.rgb,o.properties.x,o.properties.z,
        clamp(patches.values[source].filter_absorption.w,0.,1.),
        normalize(o.normal_pad.xyz),direction,D,R);
}
vec2 angular_weight(uint source,uint dst,float F,vec3 travel,float radius) {
    Optical o=optical.values[source];
    return lie_passive_weights(patches.values[dst].center_area.xyz-patches.values[source].center_area.xyz,
        patches.values[source].normal_gray.xyz,normalize(o.normal_pad.xyz),
        o.albedo_roughness.w,travel,F,cfg.tuning.w>.5,radius);
}
layout(set=0,binding=23,std430) buffer ChannelReceived { vec4 values[]; } channel_received;
layout(set=0,binding=24,std430) readonly buffer SurfaceOwners { uint values[]; } owners;



vec3 transmittance(vec3 a, vec3 b) {
    vec3 value=vec3(1.0), delta=b-a;
    float distance=length(delta);
    if(distance<1e-10) return value;
    for(int k=0;k<int(cfg.radii.w);k++) {
        Sheet s=sheets.values[k];
        vec3 n=cross(s.right_width.xyz,s.up_height.xyz);
        float denominator=dot(delta,n);
        if(abs(denominator)<1e-8) continue;
        float t=dot(s.center_thickness.xyz-a,n)/denominator;
        if(t<=0.001 || t>=0.999) continue;
        vec3 local=a+t*delta-s.center_thickness.xyz;
        if(abs(dot(local,s.right_width.xyz))>s.right_width.w || abs(dot(local,s.up_height.xyz))>s.up_height.w) continue;
        float ci=clamp(abs(denominator)/distance,0.0,1.0), eta=s.sigma_ior.w;
        float ct=sqrt(max(0.0,1.0-(1.0-ci*ci)/(eta*eta)));
        float rs=(ci-eta*ct)/max(ci+eta*ct,1e-8);
        float rp=(eta*ci-ct)/max(eta*ci+ct,1e-8);
        float f=(rs*rs+rp*rp)*0.5;
        value*=pow(1.0-f,2.0)*exp(-s.sigma_ior.rgb*s.center_thickness.w/max(ct,1e-6));
    }
    return value;
}


bool hit_box(vec3 a,vec3 b,vec3 low,vec3 high,vec4 plane,bool clip) {
    vec3 delta=b-a;float lo=.001,hi=.999;
    for(int axis=0;axis<3;axis++) {
        if(abs(delta[axis])<1e-8) {
            if(a[axis]<low[axis] || a[axis]>high[axis])return false;
        } else {
            float u=(low[axis]-a[axis])/delta[axis],v=(high[axis]-a[axis])/delta[axis];
            lo=max(lo,min(u,v));hi=min(hi,max(u,v));
        }
    }
    if(clip && lo<=hi) {
        float side=dot(plane.xyz,a)-plane.w,rate=dot(plane.xyz,delta);
        if(abs(rate)<1e-9) {if(side>0.)return false;}
        else if(rate>0.)hi=min(hi,-side/rate);
        else lo=max(lo,-side/rate);
    }
    return lo<=hi;
}
bool blocked(vec3 a,vec3 b,uint receiver_node) {
    for(int k=0;k<cfg.dims.w;k++)
        if(hit_box(a,b,blockers.values[k].lo.xyz,blockers.values[k].hi.xyz,vec4(0),false))return true;
    vec3 delta=b-a;
    for(int k=0;k<int(cfg.tuning.z);k++) {
        Triangle tri=triangles.values[k];vec3 e1=tri.b.xyz-tri.a.xyz,e2=tri.c.xyz-tri.a.xyz;
        vec3 h=cross(delta,e2);float det=dot(e1,h);if(abs(det)<1e-8)continue;
        vec3 v0=a-tri.a.xyz;float u=dot(v0,h)/det;if(u<0. || u>1.)continue;
        vec3 q=cross(v0,e1);float v=dot(delta,q)/det;if(v<0. || u+v>1.)continue;
        float t=dot(e2,q)/det;if(t>=.001 && t<=.999)return true;
    }
    for(uint k=0u;k<brick_visibility.configuration.x;k++) {
        if(k==owners.values[receiver_node])continue;
        if(hit_box(a,b,brick_visibility.bounds[k*2u].xyz,brick_visibility.bounds[k*2u+1u].xyz,
            front_caps.values[k],optical.config.z!=0u))return true;
    }
    return false;
}


vec3 rho(uint i) {
    Patch p=patches.values[i];
    return clamp(p.filter_absorption.rgb,vec3(0),vec3(1))
        *(1.0-clamp(p.filter_absorption.a,0.0,1.0))
        *clamp(p.normal_gray.w,0.0,1.0);
}

float reach(uint i, float parent, vec3 power) {
    if(cfg.tuning.w<0.5) return 0.0;
    float energy=max(power.r,max(power.g,power.b));
    // Optional Lambertian per-emitter irradiance bound, in relative power/m².
    if(cfg.tuning.w>1.5) return min(min(parent*cfg.radii.y,sqrt(energy/(PI*cfg.radii.z))),cfg.radii.x)*radius_scale.values[i];
    vec3 survival=rho(i);
    float reflection=max(survival.r,max(survival.g,survival.b));
    return min(min(parent*cfg.radii.y*sqrt(reflection),cfg.radii.x*sqrt(energy/cfg.radii.z)),cfg.radii.x)*radius_scale.values[i];
}


vec3 field_direction(uint packet,int ping) {return incidents.values[packet*2u+uint(ping)].xyz;}
bool field_step(uint id) {
    uint n=uint(cfg.dims.x),L=uint(cfg.dims.y);
    int stage=phase.data.x,ping=phase.data.y;
    if(stage==0 || stage==1)return false;
    if(stage==4) {
        if(id>=n)return true;
        vec3 total=vec3(0);
        for(uint l=0u;l<L;l++)total+=channel_received.values[l*n+id].rgb;
        received.values[id]=vec4(total,0);
        imageStore(irradiance,ivec2(int(id),0),vec4(total/max(patches.values[id].center_area.w,1e-8),1));
        return true;
    }
    if(id>=n*L)return true;
    uint node=id%n,light=id/n;
    if(stage==2) {
        float w=weights.values[light*n+node]/caps.values[light];
        vec3 incoming=lights.values[light].power.rgb*w*
            transmittance(patches.values[node].center_area.xyz,lights.values[light].position_radius.xyz);
        vec3 delta=patches.values[node].center_area.xyz-lights.values[light].position_radius.xyz;
        vec3 travel=dot(delta,delta)>1e-16?normalize(delta):-patches.values[node].normal_gray.xyz;
        incidents.values[id*2u]=vec4(travel,0);
        incidents.values[id*2u+1u]=vec4(0);
        vec3 D,R;parts(node,travel,D,R);
        float parent=max(incoming.r,max(incoming.g,incoming.b))>0.?lights.values[light].position_radius.w:0.;
        frontier_a.values[id]=vec4(incoming,reach(node,parent,incoming*(D+R)));
        frontier_b.values[id]=vec4(0);channel_received.values[id]=vec4(incoming,0);
        return true;
    }
    if(stage==5) {
        vec4 frontier=ping==0?frontier_a.values[id]:frontier_b.values[id];
        if(max(frontier.r,max(frontier.g,frontier.b))<=0.){angular_caps.values[id]=vec4(1,1,0,0);return true;}
        vec2 sum=vec2(0);uint ob=outgoing_graph.values[2],eb=outgoing_graph.values[3];
        for(uint e=outgoing_graph.values[ob+node];e<outgoing_graph.values[ob+node+1u];e++) {
            uint dst=outgoing_graph.values[eb+e*2u];float F=uintBitsToFloat(outgoing_graph.values[eb+e*2u+1u]);
            sum+=angular_weight(node,dst,F,field_direction(id,ping),frontier.w);
        }
        angular_caps.values[id]=vec4(max(sum,vec2(1)),0,0);return true;
    }
    if(stage==3) {
        uint ob=factors.values[2],eb=factors.values[3];
        vec3 incoming=vec3(0),moment=vec3(0);float parent=0.;
        for(uint e=factors.values[ob+node];e<factors.values[ob+node+1u];e++) {
            uint src=factors.values[eb+e*2u],packet=light*n+src;
            float F=uintBitsToFloat(factors.values[eb+e*2u+1u]);
            vec4 emitted=ping==0?frontier_a.values[packet]:frontier_b.values[packet];
            if(max(emitted.r,max(emitted.g,emitted.b))<=0.)continue;
            vec3 travel=field_direction(packet,ping),D,R;parts(src,travel,D,R);
            vec2 w=angular_weight(src,node,F,travel,emitted.w)/angular_caps.values[packet].xy;
            vec3 flux=emitted.rgb*(D*w.x+R*w.y)*
                transmittance(patches.values[src].center_area.xyz,patches.values[node].center_area.xyz);
            incoming+=flux;float strength=max(flux.r,max(flux.g,flux.b));
            if(strength>0.) {
                parent=max(parent,emitted.w);
                moment+=normalize(patches.values[node].center_area.xyz-patches.values[src].center_area.xyz)*strength;
            }
        }
        vec3 travel=dot(moment,moment)>1e-16?normalize(moment):-patches.values[node].normal_gray.xyz;
        incidents.values[id*2u+uint(1-ping)]=vec4(travel,0);
        vec3 D,R;parts(node,travel,D,R);float radius=reach(node,parent,incoming*(D+R));
        if(ping==0)frontier_b.values[id]=vec4(incoming,radius);
        else frontier_a.values[id]=vec4(incoming,radius);
        channel_received.values[id].rgb+=incoming;return true;
    }
    return true;
}
layout(set=0,binding=25,std430) buffer SurfaceLights {
    uvec4 header; vec4 values[];
} surface_lights;
void main() {
    if(phase.data.x==6) {
        uint id=gl_GlobalInvocationID.x,n=uint(cfg.dims.x),L=uint(cfg.dims.y);
        if(id==0u)surface_lights.header=uvec4(n,L,16,1);
        if(id<L) {
            surface_lights.values[id*2u]=lights.values[id].position_radius;
            surface_lights.values[id*2u+1u]=vec4(lights.values[id].power.rgb/caps.values[id],cfg.tuning.x);
        }
        if(id<n*L) {
            uint node=id%n,l=id/n;
            vec3 E=lights.values[l].power.rgb*(weights.values[id]/caps.values[l])*
                transmittance(patches.values[node].center_area.xyz,lights.values[l].position_radius.xyz)/
                max(patches.values[node].center_area.w,1e-8);
            surface_lights.values[16u+id]=vec4(E,1);
        }
        return;
    }
    uint i=gl_GlobalInvocationID.x;
    uint n=uint(cfg.dims.x), count=uint(cfg.dims.y);
    if(optical.config.x!=0u && optical.config.w!=0u && field_step(i))return;
    if(phase.data.x==0) {
        if(i>=n*count) return;
        uint l=i/n, p=i%n;
        if(max(lights.values[l].power.r,max(lights.values[l].power.g,lights.values[l].power.b))<=0.){weights.values[i]=0.;return;}
        vec3 delta=lights.values[l].position_radius.xyz-patches.values[p].center_area.xyz;
        float d2=dot(delta,delta), radius=lights.values[l].position_radius.w;
        float value=0.0;
        if(d2>1e-10 && radius>0.0 && !blocked(patches.values[p].center_area.xyz,lights.values[l].position_radius.xyz,p)) {
            float cosine=max(dot(patches.values[p].normal_gray.xyz,delta*inversesqrt(d2)),0.0);
            float relative=sqrt(d2)/radius;
            float window=pow(max(0.0,1.0-pow(relative,4.0)),2.0);
            value=patches.values[p].center_area.w*cosine*window/(4.0*PI*max(d2,cfg.tuning.x));
        }
        weights.values[i]=value;
        return;
    }
    if(phase.data.x==1) {
        if(i>=count) return;
        float total=0.0;
        for(uint p=0u;p<n;p++) total+=weights.values[i*n+p];
        caps.values[i]=max(1.0,total);
        return;
    }
    if(i>=n) return;
    if(phase.data.x==2) {
        vec3 incoming=vec3(0.0);
        float parent=0.0;
        for(uint l=0u;l<count;l++) {
            vec3 power=lights.values[l].power.rgb;
            float w=weights.values[l*n+i]/caps.values[l];
            incoming+=power*w*transmittance(patches.values[i].center_area.xyz,lights.values[l].position_radius.xyz);
            if(w*max(power.r,max(power.g,power.b))>0.0) parent=max(parent,lights.values[l].position_radius.w);
        }
        received.values[i]=vec4(incoming,0.0);

        vec3 travel=vec3(0);
        for(uint l=0u;l<uint(cfg.dims.y);l++) {
            float w=weights.values[l*n+i]/caps.values[l];
            vec3 flux=lights.values[l].power.rgb*w*transmittance(patches.values[i].center_area.xyz,lights.values[l].position_radius.xyz);
            travel+=normalize(patches.values[i].center_area.xyz-lights.values[l].position_radius.xyz)*max(flux.r,max(flux.g,flux.b));
        }
        travel=dot(travel,travel)>1e-16?normalize(travel):-patches.values[i].normal_gray.xyz;
        incidents.values[i*2u]=vec4(travel,0);
        vec3 power=incoming*rho(i);
        if(optical.config.x!=0u) {vec3 D,R;parts(i,travel,D,R);power=incoming*(D+R);}
        frontier_a.values[i]=vec4(optical.config.x!=0u?incoming:power,reach(i,parent,power));
        frontier_b.values[i]=vec4(0.0);
        return;
    }

    if(phase.data.x==5) {
        if(optical.config.x==0u)return;
        vec4 frontier=phase.data.y==0?frontier_a.values[i]:frontier_b.values[i];
        vec2 sum=vec2(0);uint ob=outgoing_graph.values[2],eb=outgoing_graph.values[3];
        for(uint e=outgoing_graph.values[ob+i];e<outgoing_graph.values[ob+i+1u];e++) {
            uint dst=outgoing_graph.values[eb+e*2u];float F=uintBitsToFloat(outgoing_graph.values[eb+e*2u+1u]);
            sum+=angular_weight(i,dst,F,incident(i,phase.data.y),frontier.w);
        }
        angular_caps.values[i]=vec4(max(sum,vec2(1)),0,0);return;
    }
    if(phase.data.x==3 && optical.config.x!=0u) {
        uint ob=factors.values[2],eb=factors.values[3];vec3 incoming=vec3(0),travel_sum=vec3(0);float parent=0.;
        for(uint e=factors.values[ob+i];e<factors.values[ob+i+1u];e++) {
            uint src=factors.values[eb+e*2u];float F=uintBitsToFloat(factors.values[eb+e*2u+1u]);
            vec4 emitted=phase.data.y==0?frontier_a.values[src]:frontier_b.values[src];
            vec3 D,R;parts(src,incident(src,phase.data.y),D,R);
            vec2 w=angular_weight(src,i,F,incident(src,phase.data.y),emitted.w)/angular_caps.values[src].xy;
            vec3 flux=emitted.rgb*(D*w.x+R*w.y)*transmittance(patches.values[src].center_area.xyz,patches.values[i].center_area.xyz);
            incoming+=flux;
            float strength=max(flux.r,max(flux.g,flux.b));
            if(strength>0.) {parent=max(parent,emitted.w);travel_sum+=normalize(patches.values[i].center_area.xyz-patches.values[src].center_area.xyz)*strength;}
        }
        received.values[i].rgb+=incoming;
        vec3 travel=dot(travel_sum,travel_sum)>1e-16?normalize(travel_sum):-patches.values[i].normal_gray.xyz;
        incidents.values[i*2u+uint(1-phase.data.y)]=vec4(travel,0);
        vec3 D,R;parts(i,travel,D,R);float radius=reach(i,parent,incoming*(D+R));
        if(phase.data.y==0)frontier_b.values[i]=vec4(incoming,radius);
        else frontier_a.values[i]=vec4(incoming,radius);
        return;
    }
    if(phase.data.x==3) {
        // Each generation consumes ONLY the preceding frontier. Never feed
        // accumulated total power back into the transport graph.
        vec3 incoming=vec3(0.0);
        float parent=0.0;
        // Header: [patch count, edge count, offset base, edge base].
        // Rows belong to receivers; source IDs remain in ascending order.
        uint offset_base=factors.values[2], edge_base=factors.values[3];
        for(uint edge=factors.values[offset_base+i];edge<factors.values[offset_base+i+1u];edge++) {
            uint source=factors.values[edge_base+edge*2u];
            vec4 emitted=phase.data.y==0?frontier_a.values[source]:frontier_b.values[source];
            float weight=uintBitsToFloat(factors.values[edge_base+edge*2u+1u]);
            if(cfg.tuning.w>0.5) {
                float d=distance(patches.values[source].center_area.xyz,patches.values[i].center_area.xyz);
                weight*=emitted.w>0.0?pow(max(0.0,1.0-pow(d/emitted.w,4.0)),2.0):0.0;
            }
            if(weight>0.0) incoming+=emitted.rgb*weight*transmittance(patches.values[source].center_area.xyz,patches.values[i].center_area.xyz);
            if(weight*max(emitted.r,max(emitted.g,emitted.b))>0.0) parent=max(parent,emitted.w);
        }
        received.values[i].rgb+=incoming;
        vec3 reflected=incoming*rho(i);
        if(max(reflected.r,max(reflected.g,reflected.b))<cfg.tuning.y) reflected=vec3(0.0);
        float radius=reach(i,parent,reflected);
        if(phase.data.y==0) frontier_b.values[i]=vec4(reflected,radius);
        else frontier_a.values[i]=vec4(reflected,radius);
        return;
    }
    if(phase.data.x==4) {
        vec3 e=received.values[i].rgb/max(patches.values[i].center_area.w,1e-8);
        imageStore(irradiance,ivec2(int(i),0),vec4(e,1.0));
    }
}
