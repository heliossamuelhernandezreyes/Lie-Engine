extends "res://test_lie_hq_construction.gd"
func run() -> void:
    var lab=load("res://lie_construction_mobile_lab.tscn").instantiate();lab.output_resolution=256;lab.state.mode="opening";root.add_child(lab);await settle(18)
    check(lab.metrics.get("configured",false),"mobile uses the actual construction consumer and field")
    var a: Dictionary=await capture(lab)
    check(a.field.ready and a.output_size==256,"explicit test resolution and GPU field are active")
    check(lab._benchmark_button.get_global_rect().position.y<lab.picture.get_global_rect().position.y and lab._benchmark_button.is_visible_in_tree(),"benchmark action is visible above the image without scrolling")
    var position: Vector2=lab.picture.get_global_rect().get_center();var revision: int=lab.revision
    lab.touch(1,position,true);lab.drag(1,position+Vector2(32,12));lab.touch(1,position,false)
    check(lab.revision==revision+1 and lab._fingers.is_empty(),"one-finger gesture routes through validated commands")
    var zoom: float=lab.state.zoom
    lab.touch(2,position-Vector2(50,0),true);lab.touch(3,position+Vector2(50,0),true);lab.drag(3,position+Vector2(80,0));lab.touch(2,position,false);lab.touch(3,position,false)
    check(lab.state.zoom<zoom and lab._fingers.is_empty(),"two-finger zoom and release")
    revision=lab.revision;lab.touch(4,Vector2(-20,-20),true);lab.drag(4,position);lab.touch(4,position,false)
    check(lab.revision==revision,"touches outside the image cannot move the scene")
    for bad in [true,512,960.0,"720"]:check(not lab.command({"op":"set_resolution","value":bad}).ok and lab.revision==revision,"invalid resolution is atomic")
    lab.command({"op":"set_values","values":{"yaw":-25.,"elevation":22.,"zoom":1.,"focus_x":0.,"focus_y":0.,"ambient":0.}});var indirect: Dictionary=await capture(lab)
    lab.command({"op":"set_values","values":{"indirect":false}});var direct: Dictionary=await capture(lab)
    check(indirect.depth==direct.depth and difference(indirect.color,direct.color)>.00001,"mobile field changes radiance while preserving geometry")
    var before_frames: int=lab.effect.frame_count;var diag: Dictionary=await lab._sync_metrics()
    check(diag.ready and diag.source_bytes==direct.library_bytes and diag.field.nodes==direct.field.nodes,"nonblocking metadata matches actual native allocations")
    await lab._sync_metrics();check(lab.effect.frame_count==before_frames,"diagnostics do not force reconstruction")
    var backup: Dictionary=lab.state.duplicate();var readback: Dictionary=lab.effect.readback()
    await lab.run_comparison(2)
    check(not lab.busy and lab._latest.complete and lab._latest.restored and lab.state==backup,"paired comparison restores all validated controls")
    check(lab._latest.blocks.size()==4 and lab._latest.warm_up.size()==2,"camera and light events measured in both lighting modes")
    var copied: Variant=JSON.parse_string(DisplayServer.clipboard_get())
    check(copied is Dictionary and copied.get("complete",false) and copied.get("version")==lab.APP_VERSION and copied.get("blocks",[]).size()==4,"completed benchmark automatically copies the current report")
    check(lab._progress.text.contains("Informe copiado"),"automatic copy has visible completion feedback")
    check(lab.effect.readback().color==readback.color,"benchmark never requests GPU image readbacks")
    var portable: Dictionary=lab.portable_report()
    check(not portable.blocks[0].measurements.has("appearance_rows") and not portable.blocks[0].before.resources.has("profile"),"clipboard summary omits duplicated raw arrays")
    lab.touch(6,position,true);lab._notification(Node.NOTIFICATION_APPLICATION_FOCUS_OUT)
    check(lab._fingers.is_empty(),"backgrounding clears touch ownership")
    check(FileAccess.file_exists("user://lie-construction-last.json"),"complete native report persisted")
    lab._show_report();await settle(4);lab._report_dialog.hide();await settle(4)
    var comparison: Dictionary=lab._latest.duplicate(true)
    DisplayServer.clipboard_set("LIE cancelled benchmark sentinel")
    lab.call_deferred("command",{"op":"cancel_test"});await lab.run_session(1.)
    check(lab._latest.cancelled and not lab._latest.complete and lab._latest.restored and lab.state==backup,"cancelled session is explicit and restores all settings")
    check(DisplayServer.clipboard_get()=="LIE cancelled benchmark sentinel","cancelled measurements preserve existing clipboard contents")
    lab._copy_button.pressed.emit();var manual: Variant=JSON.parse_string(DisplayServer.clipboard_get())
    check(manual is Dictionary and manual.get("cancelled",false),"visible copy action can explicitly copy a partial or cancelled report")
    check(lab.command({"op":"set_resolution","value":480}).ok,"explicit resolution change accepted")
    var resized: Dictionary=await capture(lab)
    check(resized.output_size==480 and resized.field.ready and resized.field.nodes==direct.field.nodes and lab._quality.selected==0,"resizing preserves source-owned field and updates quality control")
    lab.command({"op":"set_values","values":{"field_lighting":false}})
    check(lab.controls.fill_power.editable==false and lab.controls.indirect.disabled,"reference mode does not offer unsupported second-light controls")
    lab.command({"op":"set_values","values":{"mode":"corner","field_lighting":true,"indirect":true,"bounces":2,"ambient":1.}})
    lab.command({"op":"set_resolution","value":960});var full: Dictionary=await capture(lab)
    check(full.output_size==960 and full.field.nodes>1024 and full.field.ready,"full-quality corner works after consumer and field replacement")
    var image: Image=root.get_texture().get_image();image.save_png("res://construction-mobile-ui.png")
    var file:=FileAccess.open("res://construction-mobile-native.json",FileAccess.WRITE);file.store_string(JSON.stringify({"checks":checks,"failed":failed,"report":comparison,"cancelled_session":lab._latest,"full_quality":{"output_size":full.output_size,"field":full.field,"source_bytes":full.library_bytes,"appearance_bytes":full.exclusive_allocation_bytes},"physical_android_tested":false},"\t",true,true));file.close()
    lab.queue_free();await settle(20);print("CONSTRUCTION MOBILE ","FAIL" if failed else "PASS"," ",checks);quit(1 if failed else 0)
